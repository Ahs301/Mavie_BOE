{
  "$schema": "https://opencode.ai/config.json",

  "instructions": [
    "AGENTS.md",
    "MAVIE_MASTER_CONTEXT.md"
  ],

  "permission": {
    "edit": "ask",
    "bash": "ask"
  },

  "share": "disabled",

  "watcher": {
    "ignore": [
      "node_modules/**",
      ".next/**",
      "dist/**",
      "build/**",
      ".git/**",
      ".vercel/**",
      ".claude/**",
      "logs/**",
      "*.log",
      ".env",
      ".env.*",
      "**/.env",
      "**/.env.*",
      "stripe.env"
    ]
  }
}